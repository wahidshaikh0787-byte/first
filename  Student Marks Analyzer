        "\n",
        "import numpy as np\n",
        "\n",
        "# Step 1: Create subject names and generate random marks for 50 students across 5 subjects\n",
        "# (Using range 25-100 to ensure realistic score distributions and analysis)\n",
        "np.random.seed(42)  # Set seed for reproducibility\n",
        "subjects = np.array(['Mathematics', 'Physics', 'Chemistry', 'Computer Science', 'English'])\n",
        "marks = np.random.randint(25, 100, size=(50, 5))\n",
        "\n",
        "# Step 2: Inspect array attributes\n",
        "print(\"=== 1. ARRAY INSPECTION SUMMARY ===\")\n",
        "print(f\"Shape (Rows, Cols): {marks.shape}\")\n",
        "print(f\"Dimensions (ndim):  {marks.ndim}\")\n",
        "print(f\"Total Elements (size): {marks.size}\")\n",
        "print(f\"Data Type (dtype):  {marks.dtype}\\n\")\n",
        "\n",
        "# Step 3: Basic & Negative Indexing and 2D Slicing\n",
        "print(\"=== 2. SLICING & INDEXING ===\")\n",
        "first_10_students = marks[:10, :]\n",
        "print(f\"First 10 students marks shape: {first_10_students.shape}\")\n",
        "\n",
        "last_subject_marks = marks[:, -1]\n",
        "print(f\"Marks in last subject ({subjects[-1]}) for first 5 students: {last_subject_marks[:5]}\")\n",
        "\n",
        "core_science_marks = marks[:, 1:4]  # Columns 1 to 3 (Physics, Chemistry, CS)\n",
        "print(f\"Core science subjects marks shape: {core_science_marks.shape}\\n\")\n",
        "\n",
        "# Step 4: Boolean Masking & Grade Bands\n",
        "print(\"=== 3. BOOLEAN MASKING & GRADE BANDS ===\")\n",
        "below_40 = marks < 40\n",
        "above_90 = marks > 90\n",
        "\n",
        "print(f\"Total instances scoring below 40: {np.sum(below_40)}\")\n",
        "print(f\"Total instances scoring above 90: {np.sum(above_90)}\")\n",
        "\n",
        "# Grade Band distribution\n",
        "grade_a = np.sum((marks >= 85) & (marks <= 100))\n",
        "grade_b = np.sum((marks >= 70) & (marks < 85))\n",
        "grade_c = np.sum((marks >= 50) & (marks < 70))\n",
        "grade_d = np.sum(marks < 50)\n",
        "\n",
        "print(f\"Grade Distribution -> A (85-100): {grade_a} | B (70-84): {grade_b} | C (50-69): {grade_c} | D (<50): {grade_d}\\n\")\n",
        "\n",
        "# Step 5: Subject-wise Toppers & Pass Percentage\n",
        "print(\"=== 4. SUBJECT-WISE INSIGHTS ===\")\n",
        "subject_averages = np.mean(marks, axis=0)\n",
        "\n",
        "for i, subj in enumerate(subjects):\n",
        "    col = marks[:, i]\n",
        "    max_score = np.max(col)\n",
        "    top_student_id = np.argmax(col)\n",
        "    pass_count = np.sum(col >= 40)\n",
        "    pass_percentage = (pass_count / marks.shape[0]) * 100\n",
        "\n",
        "    print(f\"• {subj}:\")\n",
        "    print(f\"  - Average Score: {subject_averages[i]:.2f}\")\n",
        "    print(f\"  - Topper: Student #{top_student_id} with {max_score}\")\n",
        "    print(f\"  - Pass Percentage: {pass_percentage}%\\n\")"
      ]
    }
